# ─────────────────────────────────────────────────────────────────
# Variáveis do DOCKER COMPOSE (não da aplicação)
#
# Copie para `.env` NESTE diretório, ao lado do docker-compose.yml:
#
#     cp .env.example .env
#
# ─── Por que este arquivo existe, separado de backend/.env.production ────────
#
# São dois mecanismos diferentes, e confundi-los quebra a subida:
#
#   `env_file: ./backend/.env.production`  injeta variáveis DENTRO do container.
#   `${VARIAVEL}` no docker-compose.yml    é resolvido ANTES, pelo próprio
#                                          Compose, que lê apenas o shell e o
#                                          arquivo `.env` deste diretório.
#
# Ou seja: uma senha que exista só em backend/.env.production não chega às
# linhas `${POSTGRES_PASSWORD}` e `${REDIS_PASSWORD}` do compose. O Postgres
# recusa iniciar sem senha, e o Redis sobe com a linha de comando malformada
# (`--requirepass --appendonly yes`) enquanto a aplicação continua tentando
# autenticar com a senha do REDIS_URL.
#
# Os valores abaixo precisam ser IGUAIS aos de backend/.env.production.
# ─────────────────────────────────────────────────────────────────

# Precisa bater com o DATABASE_URL de backend/.env.production.
POSTGRES_USER=forensedoc_app
POSTGRES_PASSWORD=
POSTGRES_DB=forensedoc_prod

# Precisa bater com o REDIS_URL de backend/.env.production
# (redis://:SENHA@redis:6379). Gere com: openssl rand -base64 24
REDIS_PASSWORD=

# Cerca de 70% da RAM dedicada ao container do Redis. A política de despejo é
# `volatile-lru`, fixa no compose: sob pressão, o Redis descarta cache (que tem
# TTL) e nunca os jobs da fila (que não têm).
REDIS_MAXMEMORY=1gb

# Réplicas do worker. Escalar por réplica distribui memória; escalar por
# concorrência concentra tudo num processo só. Ver ESCALABILIDADE.md §2.2.
WORKER_REPLICAS=1
