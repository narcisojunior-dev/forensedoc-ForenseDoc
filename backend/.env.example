# ─────────────────────────────────────────────────────
# ForenseDoc v3.0 Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no git
# ─────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────
NODE_ENV=development
PORT=8787

# ── Banco de Dados (PostgreSQL) ───────────────────────
# Railway: use a DATABASE_URL fornecida automaticamente pelo plugin PostgreSQL
# Local (dev): use uma instância local ou container Docker
DATABASE_URL=postgresql://usuario:senha@localhost:5432/forensedoc_dev

# ── Redis ─────────────────────────────────────────────
# Railway: use a REDIS_URL fornecida automaticamente pelo plugin Redis
# Local (dev): redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Auth (JWT) ────────────────────────────────────────
# Gere valores seguros com: openssl rand -base64 32
JWT_SECRET=GERE_UM_VALOR_SEGURO_AQUI
JWT_REFRESH_SECRET=GERE_OUTRO_VALOR_SEGURO_DIFERENTE
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── Asaas (Gateway de Pagamento) ─────────────────────
# Obtenha em: https://www.asaas.com/
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# 'production' ou 'sandbox'
ASAAS_ENV=sandbox
# Allowlist de IPs dos webhooks (CIDRs separados por vírgula).
# OBRIGATÓRIA em produção: é a segunda camada de defesa do endpoint que credita
# pagamentos. Sem ela, o vazamento do ASAAS_WEBHOOK_TOKEN basta para um
# terceiro creditar laudos à vontade.
# Vazio = allowlist desativada (webhook segue protegido apenas pelo access-token).
#
# IPs oficiais de produção, conforme docs.asaas.com/docs/official-asaas-ips
# (consultado em 28/07/2026 — a Asaas já mudou essa lista antes, reconfira no
# changelog deles antes de um deploy).
ASAAS_WEBHOOK_IPS=52.67.12.206,18.230.8.159,54.94.136.112,54.94.183.101

# ── E-mail ────────────────────────────────────────────
# Sugestão: usar Resend (https://resend.com) ou Brevo/SendGrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@forensedoc.com.br

# ── Admin da Plataforma ───────────────────────────────
# E-mail do operador principal — terá isPlatformAdmin=true automaticamente
PLATFORM_ADMIN_EMAIL=

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Mapa estático (Geoapify) ─────────────────────────
# Chave gratuita (sem cartão) em https://myprojects.geoapify.com
# Usada para embutir a imagem de mapa real no §5 do laudo (PDF).
# Vazia = PDF sai sem o mapa (o §5 mantém a tabela de coordenadas).
GEOAPIFY_KEY=

# ── OCR (herdado da v2.2) ────────────────────────────
OCR_LANG=por+eng
OCR_DPI=180
OCR_MAX_PAGES=20

# ── Worker (BullMQ) ───────────────────────────────────
# Cada fila tem a sua concorrência. Deixe em branco para usar o default.
#
# ANÁLISE é limitada por CPU (OCR satura um núcleo por página): passar do número
# de núcleos não aumenta a vazão, só torna tudo mais lento ao mesmo tempo e
# multiplica o pico de memória. Default: núcleos - 1.
# WORKER_CONCURRENCY_ANALYSIS=3
#
# PAGAMENTO é I/O leve e não pode esperar: cada segundo de atraso é crédito que
# o cliente pagou e ainda não recebeu. Default: 10.
# WORKER_CONCURRENCY_PAYMENTS=10
#
# E-MAIL depende de SMTP externo. Limite pelo que o provedor aceita. Default: 5.
# WORKER_CONCURRENCY_EMAILS=5
#
# Réplicas do container de worker (docker-compose). Vazão = réplicas x
# concorrência, limitada pelos núcleos do host.
# WORKER_REPLICAS=1

# ── Métricas e alerta de fila ─────────────────────────────────────────
# Limite de ESPERA (não de profundidade) a partir do qual a fila é
# considerada saturada. Contagem sozinha não distingue "10 jobs que
# acabaram de chegar" de "10 jobs parados há 15 minutos"; o que o cliente
# sente é o tempo de espera do mais antigo.
#
# Os limites diferem por natureza do trabalho: pagamento parado há 1 minuto
# já é grave (é crédito comprado e não entregue), enquanto análise
# esperando 2 minutos em pico é fila normal.
# ALERT_WAIT_ANALYSIS_MS=300000
# ALERT_WAIT_PAYMENTS_MS=60000
# ALERT_WAIT_EMAILS_MS=600000
# ALERT_WAIT_CRONS_MS=1800000
#
# Intervalo da verificação periódica no worker.
# QUEUE_WATCH_INTERVAL_MS=60000

# ── Cache de consultas externas ───────────────────────────────────────
# Nenhuma consulta externa era cacheada, e as cotas gratuitas param muito
# antes do volume de um SaaS B2B: Nominatim tem política de 1 req/s e
# bloqueia por IP; ipapi.co dá ~1.000/dia; Geoapify dá 3.000 créditos/dia
# a 2 por laudo GERADO (o mesmo laudo baixado 3x gastava 6).
#
# TTL em segundos. Coordenada de endereço não muda; alocação de bloco de
# IP muda com o tempo, e uma atribuição envelhecida vira erro no laudo.
# CACHE_TTL_GEOCODE=31536000
# CACHE_TTL_GEOIP=2592000
#
# Mapa estático tem TTL curto porque consome memória proporcional ao
# volume: os dois mapas de um laudo ocupam ~300 KB. Em regime, o consumo
# é laudos/dia x (TTL em horas / 24) x 300 KB.
#   1.000 laudos/dia com TTL de 24h -> ~300 MB
#   1.000 laudos/dia com TTL de  6h ->  ~75 MB
# CACHE_TTL_STATIC_MAP=21600
#
# Teto por item cacheado. Resposta muito acima do tamanho típico indica
# mudança na API ou erro devolvido como imagem.
# CACHE_MAX_BYTES=1048576

# ── Limites por plano ─────────────────────────────────────────────────
# Análises simultâneas e vazão por minuto vêm do PLANO do tenant, não de
# constante global. Os defaults do schema (1 simultânea, 2 por minuto)
# reproduzem o mutex e a janela de 30s que existiam antes, então
# assinantes atuais não percebem mudança até o plano ser ajustado no
# painel administrativo.
#
# Cache dos limites. Curto de propósito: mudar o plano de um cliente
# precisa valer em segundos, não depois de um deploy.
# PLAN_LIMITS_CACHE_TTL=60
#
# Janela da idempotência por conteúdo, em segundos. O reenvio do MESMO
# arquivo dentro dela devolve a análise existente sem cobrar de novo.
# Curta de propósito: reanalisar o mesmo documento depois é legítimo (o
# operador pode ter corrigido a coordenada de referência).
# ANALYZE_IDEMPOTENCY_TTL=120

# ── Cloudflare R2 (armazenamento do PDF enviado) ──────────────────────
# Sem estas variáveis o sistema FUNCIONA, mas volta a trafegar o PDF em
# base64 dentro do payload do job, que vive no Redis: ~40 MB de memória
# por análise enfileirada. Em produção, preencher.
#
# Token de API com permissão Object Read & Write, restrito ao bucket.
# O bucket NÃO pode ter acesso público: guarda contrato com dado pessoal.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=forensedoc-uploads
#
# Retenção do PDF ORIGINAL, em dias. O laudo e os hashes (SHA-256/SHA-1)
# permanecem: a integridade continua demonstrável depois do expurgo.
# A rotina roda às 3h e registra a data em Analysis.pdfPurgedAt, que é o
# que comprova cumprimento da política. Ver §12.6 do documento de
# auditoria para o racional.
# R2_RETENTION_DAYS=90

# ── Pool de conexões do Postgres ──────────────────────────────────────
# O adapter herdava o default do `pg`: 10 conexões POR PROCESSO. O worker
# pode querer mais que isso (4 análises + 10 pagamentos + 5 e-mails em
# paralelo), e do outro lado o Postgres tem max_connections global
# (tipicamente 100): réplicas x pool encostam no teto depois que o
# `--scale` passou a ser possível.
#
# Os defaults diferem por papel (WORKER_MODE=true no compose do worker):
#   api     15
#   worker  soma das concorrências + 5
# Deixe em branco salvo necessidade específica.
# DB_POOL_MAX=
# DB_CONNECT_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000

# ── Divisão justa entre usuários do mesmo tenant ──────────────────────
# O semáforo de análises é do TENANT, então um usuário que envia 50
# documentos ocupava todas as vagas e deixava os colegas sem nenhuma.
# A cota de cada um é o limite do plano dividido por quantos disputam a
# capacidade AGORA: sozinho, o usuário usa tudo; com colegas, divide.
#
# Um usuário recusado conta como disputante por este prazo. Sem isso,
# quem chegou primeiro liberava uma vaga e a retomava na hora, e o colega
# nunca entrava. Curto demais e o pretendente some antes de conseguir;
# longo demais e quem desistiu reduz a cota de quem ficou.
# SLOT_PRETENDENTE_TTL_MS=90000

# ── Retenção das tabelas que crescem sem parar ────────────────────────
# `audit_logs` guarda IP e user-agent, que são dado pessoal: mantê-los
# para sempre é o mesmo problema que motivou a retenção do PDF, e passou
# despercebido porque a atenção estava no upload.
#
# Auditoria: 12 meses por padrão. O piso de 180 dias é OBRIGAÇÃO LEGAL
# (Marco Civil, art. 15) e o código corrige valores abaixo dele, com
# aviso no log. Notificações: só as já lidas, 6 meses.
# AUDIT_RETENTION_DAYS=365
# NOTIFICATION_RETENTION_DAYS=180

# ── Custo estimado do OCR por página ──────────────────────────────────
# Base do orçamento de tempo (OCR_MAX_PAGES x este valor). A primeira
# estimativa era 6000, tirada da MÉDIA de 5 páginas, e o teste de carga
# mostrou o erro: um prazo colocado sobre a média falha metade das vezes.
# Medido com documento escaneado real: ~5s/página, com execuções batendo
# em 120s para 20 páginas. 9000 dá ~70% de folga.
# OCR_COST_PER_PAGE_MS=9000
#
# O orçamento final é OCR_MAX_PAGES x custo x raiz(concorrência), porque o
# prazo é tempo de RELÓGIO e a duração depende de quantas análises rodam
# juntas. Medido: mediana de 99s com concorrência 1 e 175,6s com 4; com
# prazo fixo de 180s, a concorrência 4 (o default) falharia metade das
# vezes. Use OCR_TIMEOUT_MS para fixar um valor e ignorar o cálculo.

# ── Timeouts ──────────────────────────────────────────
# Timeout do OCR (ms). DEIXE EM BRANCO salvo necessidade específica.
#
# O valor fixo de 60000 que estava aqui era menor que o custo real do trabalho
# aceito: 20 páginas custam cerca de 112 s (medido a 180 DPI), então documentos
# escaneados acima de ~11 páginas falhavam e tinham o crédito estornado. Sem
# esta variável, o prazo é derivado de OCR_MAX_PAGES e acompanha qualquer ajuste.
# OCR_TIMEOUT_MS=
#
# Timeout do endpoint /analyze (ms). É o tempo de RECEBER o upload, não o de
# processar: a rota responde 202 e o trabalho segue no worker.
ANALYZE_TIMEOUT_MS=90000

# ── Limites de Upload ─────────────────────────────────
# Tamanho máximo do PDF em MB (validado antes do processamento)
MAX_PDF_MB=30

# ── Painel administrativo ─────────────────────────────
# Allowlist de IP do painel (/api/admin/*). CIDRs separados por vírgula.
# OBRIGATÓRIA em produção: o painel concede crédito, suspende contas e edita
# preços, e sem ela fica valendo apenas a senha do operador. Vazio BLOQUEIA o
# painel em produção (fail-closed) e libera em desenvolvimento.
# Descubra seu IP com: curl -s ifconfig.me
# Ex.: ADMIN_ALLOWED_IPS=203.0.113.10/32,198.51.100.0/24
ADMIN_ALLOWED_IPS=
