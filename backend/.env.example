# ─────────────────────────────────────────────────────
# ForenseDoc v3.0 Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no git
# ─────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────
NODE_ENV=development
PORT=8787

# ── Banco de Dados (PostgreSQL) ───────────────────────
# Railway: use a DATABASE_URL fornecida automaticamente pelo plugin PostgreSQL
# Local (dev): use uma instância local ou container Docker
DATABASE_URL=postgresql://usuario:senha@localhost:5432/forensedoc_dev

# ── Redis ─────────────────────────────────────────────
# Railway: use a REDIS_URL fornecida automaticamente pelo plugin Redis
# Local (dev): redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Auth (JWT) ────────────────────────────────────────
# Gere valores seguros com: openssl rand -base64 32
JWT_SECRET=GERE_UM_VALOR_SEGURO_AQUI
JWT_REFRESH_SECRET=GERE_OUTRO_VALOR_SEGURO_DIFERENTE
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── Asaas (Gateway de Pagamento) ─────────────────────
# Obtenha em: https://www.asaas.com/
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# 'production' ou 'sandbox'
ASAAS_ENV=sandbox
# Allowlist de IPs dos webhooks (CIDRs separados por vírgula).
# Consulte a faixa atual na documentação de webhooks da Asaas.
# Vazio = allowlist desativada (webhook segue protegido pelo access-token).
ASAAS_WEBHOOK_IPS=

# ── E-mail ────────────────────────────────────────────
# Sugestão: usar Resend (https://resend.com) ou Brevo/SendGrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@forensedoc.com.br

# ── Admin da Plataforma ───────────────────────────────
# E-mail do operador principal — terá isPlatformAdmin=true automaticamente
PLATFORM_ADMIN_EMAIL=

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Mapa estático (Geoapify) ─────────────────────────
# Chave gratuita (sem cartão) em https://myprojects.geoapify.com
# Usada para embutir a imagem de mapa real no §5 do laudo (PDF).
# Vazia = PDF sai sem o mapa (o §5 mantém a tabela de coordenadas).
GEOAPIFY_KEY=

# ── OCR (herdado da v2.2) ────────────────────────────
OCR_LANG=por+eng
OCR_DPI=180
OCR_MAX_PAGES=20

# ── Worker (BullMQ) ───────────────────────────────────
# Worker roda automaticamente junto com o servidor

# ── Timeouts ──────────────────────────────────────────
# Timeout máximo para processamento OCR (ms)
OCR_TIMEOUT_MS=60000
# Timeout máximo para o endpoint /analyze (ms)
ANALYZE_TIMEOUT_MS=90000

# ── Limites de Upload ─────────────────────────────────
# Tamanho máximo do PDF em MB (validado antes do processamento)
MAX_PDF_MB=30
