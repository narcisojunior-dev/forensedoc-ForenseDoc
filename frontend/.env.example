# ─────────────────────────────────────────────────────────────
# ForenseDoc v3.0 Frontend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no git
# ─────────────────────────────────────────────────────────────

# URL base da API (backend)
# Desenvolvimento: deixar vazio — o proxy do Vite encaminha /api ao localhost:8787
# Railway/Produção: URL do seu backend no Railway
# Exemplo: https://forensedoc-backend.up.railway.app
VITE_API_BASE=

# Ambiente (development | production)
VITE_NODE_ENV=development
